# Main agent model. Leave unset to use the ConnectOnion default.
# CONNECTONION_MODEL=

# Bring your own provider key by setting the matching API key and using a model
# name without the co/ prefix. Never commit real keys.
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# MISTRAL_API_KEY=

# Model for auxiliary plan generation. Independent of the main agent model so a
# heavy CONNECTONION_MODEL never forces this cheap side call onto it.
# Leave unset to use the fast default (co/gemini-2.5-flash).
# CONNECTONION_PLAN_MODEL=

# Online LLM-as-judge evaluation is intentionally disabled by default.
CONNECTONION_ENABLE_EVAL=0

# Reflection policy: on_failure, always, or off.
CONNECTONION_REFLECTION_MODE=on_failure

# Comma-separated hosted capability groups.
CONNECTONION_TOOLSETS=workspace,web,todo
